def calculate_bill():
    BASE_CONSULTATION_FEE = 100.0
    LAB_TEST_RATE = 10.0
    DISCOUNT_RATE = 0.70

    # 1. Input Validation: Patient Type
    while True:
        patient_type = input("Enter patient type (Subsidised or Private): ").strip().capitalize()
        if patient_type in ["Subsidised", "Private"]:
            break
        print("Invalid entry. Please enter 'Subsidised' or 'Private'.")

    # 2. Input Validation: Number of Lab Tests
    while True:
        raw_input = input("Enter the number of lab tests completed: ").strip()
        if raw_input.isdigit():
            num_lab_tests = int(raw_input)
            break
        print("Invalid entry. Please enter a valid non-negative whole number.")

    # 3. Calculation
    subtotal = BASE_CONSULTATION_FEE + (num_lab_tests * LAB_TEST_RATE)

    if patient_type == "Subsidised":
        total_amount = subtotal * DISCOUNT_RATE
    else:
        total_amount = subtotal

    # 4. Output
    print("\n--- Bill Summary ---")
    print(f"Patient Type: {patient_type}")
    print(f"Total Amount to Pay: ${total_amount:.2f}")

calculate_bill()
